# BalVoi public website (story URLs)
BALVOI_SITE_URL=https://staging.balvoi.com
# NewsGenie API engine (MongoDB articles)
BALVOI_API_URL=https://api.staging.newsgenie.ai
BALVOI_API_KEY=your_balvoi_api_key_here
# Articles endpoint path under BALVOI_API_URL (default /podcast_articles).
# Use a path only — not a full URL:
#   BALVOI_API_ARTICLES_PATH=/podcast_articles
BALVOI_API_ARTICLES_PATH=/podcast_articles
# Podcast fetch: article limit and optional since override for testing (ISO-8601 UTC)
BALVOI_ARTICLE_LIMIT=200
BALVOI_SINCE_OVERRIDE=
# Local test mode: use demo articles when API returns nothing
BALVOI_ALLOW_DEMO_ARTICLES=false
# Only pick articles published in the last N minutes (fallback: latest available)
BALVOI_ARTICLE_WINDOW_MINUTES=60
BALVOI_STORY_COOLDOWN_MINUTES=360

# AI: NewsGenie Bedrock prompt (translation + headline rewrite)
# Uses BALVOI_API_URL + BALVOI_API_KEY → POST /bedrock/prompt
# Legacy OpenAI vars are unused by the pipeline LLM path:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ElevenLabs TTS (required for real audio)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# AWS Bedrock (optional future primary)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Backend
PORT=3001
# Runtime profile: development | test | staging | production
BALVOI_ENV=development
SCHEDULER_ENABLED=true                    # process at UTC :51; publish at next :00
# Legacy alias (deprecated): CRON_ENABLED — must not conflict with SCHEDULER_ENABLED
STORAGE_PATH=storage
# Must be a real public HTTPS origin in staging/production (and whenever Megaphone is enabled).
# Do NOT use example.com / podcast.example.com / localhost.
PUBLIC_BASE_URL=
# Break-glass for local private hosts only (ignored for placeholders; blocked in staging/production):
# BALVOI_ALLOW_PRIVATE_PUBLIC_BASE_URL=false
PODCAST_OWNER_NAME=BalVoi:60
PODCAST_OWNER_EMAIL=podcasts@example.com
PODCAST_ARTWORK_BASE_URL=

# Pipeline: all 8 editions (BalVoi:60 hourly; min publish duration is separate)
PIPELINE_EDITIONS=en,es,pt,fr,de,ar,ru,tr
DRY_RUN=false
MIN_PUBLISH_DURATION_SECONDS=600
LANGUAGE_WORKER_CONCURRENCY=4
TRANSLATION_CONCURRENCY=4
TTS_REQUEST_CONCURRENCY=3
MERGE_CONCURRENCY=2
# Optional: emit one JSON log line per pipeline/scheduler event (default off).
# BALVOI_STRUCTURED_LOGS=false
# HTTP_READ_TIMEOUT_SECONDS=45
# HTTP_RETRY_LIMIT=3
# FFMPEG_PATH=
# LOG_LEVEL=INFO

# Megaphone publication (leave MEGAPHONE_ENABLED=false until token + public URL work).
# Shared org defaults (used when per-slug token/network are empty):
MEGAPHONE_ENABLED=false
# Main-path Create Episode at/after :00 uses draft=false (live). Keep Megaphone
# disabled until PUBLIC_BASE_URL is a real public HTTPS origin (CDN/S3).
# MEGAPHONE_CREATE_AS_DRAFT still applies to helpers that omit draft=.
MEGAPHONE_CREATE_AS_DRAFT=true
MEGAPHONE_API_TOKEN=
MEGAPHONE_NETWORK_ID=99184232-8214-11f1-9caf-57ae77772f7c
#
# Optional: upload episode MP3s to S3 (key episodes/{run_id}/{slug}.mp3).
# When unset, local storage/episodes must be served by PUBLIC_BASE_URL.
# BALVOI_EPISODE_S3_BUCKET=
# AWS_REGION=us-east-1
#
# PUBLIC_BASE_URL must be the real public HTTPS origin that serves
# {PUBLIC_BASE_URL}/episodes/{run_id}/{slug}.mp3 — never example.com / localhost.
# Per-edition podcast IDs (required when Megaphone is enabled):
#   en  Five Eyes Edition              d5ec793c-8217-11f1-bbbf-5f8263c69d73
#   es  Noticias Latinoamérica         1d30c1a2-821a-11f1-bc47-0bc5cfb8f95f
#   pt  Notícias Brasil                935df854-821a-11f1-b449-7381ad34ea7c
#   fr  Actualités                     91263dbe-8218-11f1-976b-7fcc831b2f66
#   de  Nachrichten                    7c81fdca-8219-11f1-8490-b32d7df4e01d
#   ar  أخبار                          6d3daf74-821b-11f1-acaa-2b4c33ddb374
#   ru  Новости                        078627b0-821b-11f1-8e8a-0bdd805cdacb
#   tr  Haberler                       10d04c30-8219-11f1-8278-43048bccad69
#
# Optional per-slug overrides (fall back to MEGAPHONE_API_TOKEN / MEGAPHONE_NETWORK_ID):
MEGAPHONE_API_TOKEN_EN=
MEGAPHONE_NETWORK_ID_EN=
MEGAPHONE_PODCAST_ID_EN=d5ec793c-8217-11f1-bbbf-5f8263c69d73
MEGAPHONE_API_TOKEN_ES=
MEGAPHONE_NETWORK_ID_ES=
MEGAPHONE_PODCAST_ID_ES=1d30c1a2-821a-11f1-bc47-0bc5cfb8f95f
MEGAPHONE_API_TOKEN_PT=
MEGAPHONE_NETWORK_ID_PT=
MEGAPHONE_PODCAST_ID_PT=935df854-821a-11f1-b449-7381ad34ea7c
MEGAPHONE_API_TOKEN_FR=
MEGAPHONE_NETWORK_ID_FR=
MEGAPHONE_PODCAST_ID_FR=91263dbe-8218-11f1-976b-7fcc831b2f66
MEGAPHONE_API_TOKEN_DE=
MEGAPHONE_NETWORK_ID_DE=
MEGAPHONE_PODCAST_ID_DE=7c81fdca-8219-11f1-8490-b32d7df4e01d
MEGAPHONE_API_TOKEN_AR=
MEGAPHONE_NETWORK_ID_AR=
MEGAPHONE_PODCAST_ID_AR=6d3daf74-821b-11f1-acaa-2b4c33ddb374
MEGAPHONE_API_TOKEN_RU=
MEGAPHONE_NETWORK_ID_RU=
MEGAPHONE_PODCAST_ID_RU=078627b0-821b-11f1-8e8a-0bdd805cdacb
MEGAPHONE_API_TOKEN_TR=
MEGAPHONE_NETWORK_ID_TR=
MEGAPHONE_PODCAST_ID_TR=10d04c30-8219-11f1-8278-43048bccad69
